{
  "name": "kw-bench-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:syntax && npm test",
    "check:syntax": "node --check src/index.js && node --check ops/uploader-worker.mjs && node --check scripts/deploy.mjs && python3 -m py_compile scripts/*.py",
    "test": "node --test test/*.test.mjs",
    "cf:types": "wrangler types",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "4.131.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
